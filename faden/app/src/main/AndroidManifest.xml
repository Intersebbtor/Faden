<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Metered-network checks: Data saving "On mobile data" and HD video "WiFi only". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Watched communities and the inbox check notify. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving media to Pictures/ and Movies/; Android 10+ needs no permission for that. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Read aloud finds the device's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Reddit links Faden has no page for go to a browser, found by name so they don't come back here. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".FadenApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Faden"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Reddit web links. Not verified (the domain isn't ours), so on Android 12+ the user turns them on
                 under the app's "Open by default" (Settings › Link handling links there). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="reddit.com" />
                <data android:host="*.reddit.com" />
                <data android:host="redd.it" />
            </intent-filter>
            <!-- Sharing a link, text or a picture to Faden starts a new post with it (SharedContent.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Shows a crash's stack trace to copy or share; its own process, so the app's crash can't take it down. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash" />
        <receiver
            android:name=".watch.WatchWorker$StopWatchingReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.InboxWorker$InboxActionReceiver"
            android:exported="false" />
    </application>
</manifest>
